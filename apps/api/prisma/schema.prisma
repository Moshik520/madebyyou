// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt



  designProjects DesignProject[]
  cart           Cart?
  orders         Order[]
  assets         Asset[]



  @@map("users")
}


model Product {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String
  basePrice   Decimal  @db.Decimal(10, 2)
  imageUrl    String
  printArea   Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt



  designProjects DesignProject[]
  cartItems      CartItem[]
  orderItems     OrderItem[]


  @@map("products")
}

enum DesignProjectStatus {
  DRAFT
  READY
  ORDERED
}

model DesignProject {
  id               String              @id @default(uuid())
  userId           String
  productId        String
  title            String
  status           DesignProjectStatus @default(DRAFT)
  brief            Json?
  currentVersionId String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  conversation   Conversation?
  versions       DesignVersion[] @relation("ProjectVersions")
  currentVersion DesignVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
  @@map("design_projects")
}


model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id              String   @id @default(uuid())
  cartId          String
  productId       String
  designVersionId String?
  quantity        Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}


enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model Order {
  id         String      @id @default(uuid())
  userId     String
  status     OrderStatus @default(PENDING)
  currency   String      @default("ILS")
  subtotal   Decimal     @db.Decimal(10, 2)
  total      Decimal     @db.Decimal(10, 2)
  paymentRef String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String
  designVersionId String?

  productName String
  productSlug String
  imageUrl    String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}


enum AssetKind {
  UPLOAD
  ARTWORK
  MOCKUP
}

model Asset {
  id         String    @id @default(uuid())
  userId     String
  kind       AssetKind
  mimeType   String
  width      Int
  height     Int
  bytes      Int
  storageKey String    @unique
  createdAt  DateTime  @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  artworkOf DesignVersion[] @relation("VersionArtwork")
  mockupOf  DesignVersion[] @relation("VersionMockup")

  @@index([userId])
  @@map("assets")
}

model Conversation {
  id        String   @id @default(uuid())
  projectId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id              String      @id @default(uuid())
  conversationId  String
  role            MessageRole
  content         String
  designVersionId String?
  createdAt       DateTime    @default(now())

  conversation  Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  designVersion DesignVersion? @relation(fields: [designVersionId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@map("messages")
}

model DesignVersion {
  id                   String   @id @default(uuid())
  projectId            String
  versionNumber        Int
  brief                Json
  imagePrompt          String?
  artworkAssetId       String?
  mockupAssetId        String?
  provider             String
  derivedFromVersionId String?
  createdAt            DateTime @default(now())

  project   DesignProject  @relation("ProjectVersions", fields: [projectId], references: [id], onDelete: Cascade)
  artwork   Asset?         @relation("VersionArtwork", fields: [artworkAssetId], references: [id], onDelete: SetNull)
  mockup    Asset?         @relation("VersionMockup", fields: [mockupAssetId], references: [id], onDelete: SetNull)
  messages  Message[]
  currentOf DesignProject? @relation("CurrentVersion")

  derivedFrom DesignVersion?  @relation("DerivedDesigns", fields: [derivedFromVersionId], references: [id], onDelete: SetNull)
  derivatives DesignVersion[] @relation("DerivedDesigns")

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@map("design_versions")
}
